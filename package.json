{
  "name": "commons-shared",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/commons-shared.cjs.js",
  "module": "./dist/commons-shared.es.js",
  "types": "./dist/index.d.ts",
