    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^3.9.0",
    "@mui/material": "^5.18.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-hook-form": "^7.52.1",
    "yup": "^1.7.1"
  },
  "dependencies": {
    "@mui/lab": "^5.0.0-alpha",
    "@mui/x-date-pickers": "^8.12.0",
    "moment": "^2.30.1",
    "react-icons": "^5.5.0"
  },
  "scripts": {
    "dev": "vite",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "clean": "rimraf dist",
    "build": "npm run clean && vite build && tsc -p tsconfig.build.json",
